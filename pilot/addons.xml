<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="plugin.video.tvhonedrive" name="TVHeadend OneDrive Archive" version="0.2.1" provider-name="AFM Group">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Browse and play your private TVHeadend OneDrive recordings</summary>
      <description lang="en_GB">Private OneDrive Personal archive with per-device Microsoft sign-in and a resilient loopback range-streaming service.</description>
      <platform>all</platform>
      <license>MIT</license>
      <source>https://github.com/afmgroup/tvh-onedrive-archive</source>
    </extension>
  </addon>
  <addon id="repository.afmgroup.pilot" name="AFM Group Kodi Add-ons" version="1.0.0" provider-name="AFM Group">
    <requires>
      <import addon="xbmc.addon" version="12.0.0" />
    </requires>
    <extension point="xbmc.addon.repository">
      <dir>
        <info compressed="false">https://raw.githubusercontent.com/afmgroup/kodi-addons/main/pilot/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/afmgroup/kodi-addons/main/pilot/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/afmgroup/kodi-addons/main/pilot/</datadir>
        <hashes>false</hashes>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Install and update AFM Group add-ons</summary>
      <description lang="en_GB">TVHeadend OneDrive recordings</description>
      <platform>all</platform>
    </extension>
  </addon>
</addons>